<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AssemblyName>OpenSpeed.Classic</AssemblyName>
    <RootNamespace>OpenSpeed.Classic</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuciCLI.Arguments" Version="1.0.1" />
    <PackageReference Include="NuciXNA.Graphics" Version="2.2.5" />
    <PackageReference Include="NuciXNA.Gui" Version="3.4.2" />
    <PackageReference Include="NuciXNA.Input" Version="2.1.1" />
    <PackageReference Include="NuciXNA.Primitives" Version="2.1.7" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
